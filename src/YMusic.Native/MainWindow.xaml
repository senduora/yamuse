                </Button>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</Grid>

    <Grid x:Name="ArtistPanel" Grid.Column="1" Margin="28,24,28,14" Visibility="Collapsed">
