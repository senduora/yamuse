                    <Border Width="132" Height="132" CornerRadius="13" Background="{DynamicResource CoverPlaceholderBrush}" HorizontalAlignment="Left" Margin="0,0,0,11">
                      <Grid>
                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image Width="132" Height="132" Stretch="UniformToFill" local:Artwork.SourceUri="{Binding CoverUri}" local:Artwork.PixelSize="128"><Image.Clip><RectangleGeometry Rect="0,0,132,132" RadiusX="13" RadiusY="13"/></Image.Clip></Image>
