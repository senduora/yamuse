      <TextBlock x:Name="HomeStatus" Text="Подборки, новые открытия и музыка под ваше настроение" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,25"/>
      <Grid Margin="0,0,0,27">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Button Style="{StaticResource HomeHeroButton}" Margin="0,0,8,0" Click="Wave_Click" AutomationProperties.Name="Открыть Мою волну">
          <Button.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#513242" Offset="0"/><GradientStop Color="#302A40" Offset="1"/></LinearGradientBrush></Button.Background>
          <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,20"><TextBlock Text="Моя волна" FontSize="27" FontWeight="Bold" Foreground="#FFF1F5"/><TextBlock Text="Новые открытия в вашем ритме" Margin="0,7,12,0" Foreground="#CCB9CC" FontSize="12" TextWrapping="Wrap"/></StackPanel>
            <Grid Grid.Row="1"><TextBlock Text="Открыть волну" Foreground="#FBE5EE" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Width="37" Height="37" CornerRadius="19" Background="#F9DBE8" HorizontalAlignment="Right"><TextBlock Text="▶" Foreground="#493041" FontSize="14" Margin="2,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid>
