          <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,20"><TextBlock Text="Волна по коллекции" FontSize="25" FontWeight="Bold" Foreground="#ECF5F1" TextWrapping="Wrap"/><TextBlock Text="Ваши любимые — начало новых открытий" Margin="0,7,12,0" Foreground="#ABC3C1" FontSize="12" TextWrapping="Wrap"/></StackPanel>
            <Grid Grid.Row="1"><TextBlock Text="На основе любимого" Foreground="#D4ECE3" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Width="37" Height="37" CornerRadius="19" Background="#D0E9DF" HorizontalAlignment="Right"><TextBlock Text="▶" Foreground="#294440" FontSize="14" Margin="2,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid>
          </Grid>
        </Button>
      </Grid>
      <TextBlock x:Name="HomeEmpty" Text="Подборки появятся после загрузки главной." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="14" Margin="0,7,0,28" Visibility="Collapsed"/>
