                <WrapPanel Margin="0,18,0,0"><Button x:Name="ArtistPlayButton" Content="▶ Слушать" Click="ArtistPlay_Click" Style="{StaticResource AccentButton}" Margin="0,0,10,4"/><Button x:Name="ArtistLikeButton" Content="♡ В коллекцию" Click="ArtistLike_Click" Style="{StaticResource QuietButton}" Margin="0,0,0,4"/></WrapPanel>
