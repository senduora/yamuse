<Window x:Class="YMusic.Native.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:YMusic.Native"
        Title="Yamuse" Style="{StaticResource {x:Type Window}}" Width="1280" Height="860" MinWidth="1050" MinHeight="680" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" PreviewKeyDown="Window_KeyDown" PreviewMouseDown="Window_PreviewMouseDown">

  <Window.Resources>
    <local:CatalogGroupLabel x:Key="CatalogGroupLabel"/>
    <Style x:Key="ArtistLink" TargetType="Button" BasedOn="{StaticResource TextLink}">
      <Setter Property="Padding" Value="0,2,0,2"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="ToolTip" Value="Открыть исполнителя"/>
    </Style>
    <Style x:Key="TrackTitleLink" TargetType="Button" BasedOn="{StaticResource ArtistLink}"><Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="TrackMoreButton" TargetType="Button" BasedOn="{StaticResource PlayerButton}">
      <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Content" Value="⋯"/><Setter Property="FontSize" Value="20"/><Setter Property="ToolTip" Value="Действия с треком"/>
      <Setter Property="AutomationProperties.Name" Value="Действия с треком"/><Setter Property="Opacity" Value="0"/>
      <Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger><DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Opacity" Value="1"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="TrackLikeMark" TargetType="Button" BasedOn="{StaticResource TextLink}">
      <Setter Property="Width" Value="28"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="15"/><Setter Property="Content" Value="&#xEB51;"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="IsEnabled" Value="{Binding CanToggleLike}"/>
      <Setter Property="ToolTip" Value="Добавить в Мне нравится"/><Setter Property="AutomationProperties.Name" Value="Добавить в Мне нравится"/>
      <Style.Triggers><DataTrigger Binding="{Binding IsLiked}" Value="True"><Setter Property="Content" Value="&#xEB52;"/><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/><Setter Property="ToolTip" Value="Убрать из Мне нравится"/><Setter Property="AutomationProperties.Name" Value="Убрать из Мне нравится"/></DataTrigger><DataTrigger Binding="{Binding LikeStateKnown}" Value="False"><Setter Property="ToolTip" Value="Загружаем отметки Мне нравится…"/></DataTrigger></Style.Triggers>
    </Style>
    <DataTemplate x:Key="TrackStatusBadges"><Grid Width="62" Height="30"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
      <Button x:Name="TrackLikeButton" Tag="{Binding}" Click="TrackLike_Click" Style="{StaticResource TrackLikeMark}"/>
      <TextBlock x:Name="TrackDownloadedBadge" Grid.Column="1" Text="&#xE896;" HorizontalAlignment="Center" ToolTip="{Binding DownloadedQuality}" AutomationProperties.Name="Скачано"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource DownloadIcon}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsDownloaded}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid></DataTemplate>
    <Style x:Key="TrackCoverButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="White"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="IsEnabled" Value="{Binding CanPlay, FallbackValue=False}"/><Setter Property="ToolTip" Value="Слушать трек"/><Setter Property="AutomationProperties.Name" Value="{Binding Title, StringFormat='Слушать {0}'}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid Background="Transparent">
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Path x:Name="TrackCoverPlayGlyph" Data="M 0,0 L 0,16 L 12,8 Z" Width="12" Height="16" Stretch="Uniform" Fill="White" Stroke="#60000000" StrokeThickness="0.5" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"><Path.Effect><DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="0" Opacity="0.65"/></Path.Effect></Path>
        <Border x:Name="CoverKeyboardFocus" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}" Opacity="0" IsHitTestVisible="False"/>
      </Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TrackCoverPlayGlyph" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="local:InputFeedback.KeyboardFocusVisible" Value="True"><Setter TargetName="CoverKeyboardFocus" Property="Opacity" Value="1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="TrackCoverPlayGlyph" Property="Visibility" Value="Collapsed"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="TrackCover"><Button x:Name="TrackCoverPlayButton" Tag="{Binding}" Click="TrackCoverPlay_Click" Style="{StaticResource TrackCoverButton}"><Border Width="34" Height="34" Background="{DynamicResource CoverPlaceholderBrush}" CornerRadius="6"><Grid><TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Width="34" Height="34" Stretch="UniformToFill" local:Artwork.SourceUri="{Binding CoverUri}" local:Artwork.PixelSize="64"><Image.Clip><RectangleGeometry Rect="0,0,34,34" RadiusX="6" RadiusY="6"/></Image.Clip></Image></Grid></Border></Button></DataTemplate>
    <DataTemplate x:Key="TrackArtistLinks">
      <Grid VerticalAlignment="Center" ClipToBounds="True" ContextMenuOpening="TrackArtists_ContextMenuOpening">
        <ItemsControl ItemsSource="{Binding Artists}" AlternationCount="2147483647"><ItemsControl.ItemsPanel><ItemsPanelTemplate><DockPanel LastChildFill="False"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text=", " Foreground="{StaticResource MutedBrush}" FontSize="13" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <Button Grid.Column="1" Tag="{Binding}" Style="{StaticResource ArtistLink}" Click="ArtistName_Click"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></Button>
          </Grid></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Tag="{Binding}" Click="ArtistName_Click" HorizontalAlignment="Left">
          <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ArtistLink}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Artists.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
          <TextBlock Text="{Binding Artist}" TextTrimming="CharacterEllipsis"/>
        </Button>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="CatalogResultRow">
      <Border x:Name="ResultSurface" Padding="8,5" MinHeight="58" CornerRadius="9" Background="Transparent" Margin="0,1">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="56"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
          <Grid Width="34" Height="34" HorizontalAlignment="Left" VerticalAlignment="Center"><Button x:Name="CatalogCoverLink" Tag="{Binding}" Click="CatalogTitle_Click" Style="{StaticResource ArtistLink}" Padding="0" Width="34" Height="34" ToolTip="Открыть альбом или подборку"><Border Width="34" Height="34" CornerRadius="7" Background="{DynamicResource CoverPlaceholderBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"><Grid>
            <TextBlock Text="♪" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Image Width="34" Height="34" Stretch="UniformToFill" local:Artwork.SourceUri="{Binding CoverUri}" local:Artwork.PixelSize="64"><Image.Clip><RectangleGeometry Rect="0,0,34,34" RadiusX="7" RadiusY="7"/></Image.Clip></Image>
          </Grid></Border></Button><ContentControl x:Name="CatalogTrackCover" Content="{Binding Track}" ContentTemplate="{StaticResource TrackCover}" Visibility="Collapsed"/></Grid>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
            <Button Tag="{Binding}" Click="CatalogTitle_Click" Style="{StaticResource TrackTitleLink}" ToolTip="Открыть альбом или подборку"><TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/></Button>
            <TextBlock x:Name="CatalogSubtitle" Text="{Binding DisplaySubtitle}" MinHeight="16" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
            <ContentControl x:Name="CatalogArtists" Content="{Binding Track}" ContentTemplate="{StaticResource TrackArtistLinks}" Visibility="Collapsed"/>
          </StackPanel>
          <ContentControl x:Name="CatalogTrackMarks" Grid.Column="2" Content="{Binding Track}" ContentTemplate="{StaticResource TrackStatusBadges}" Visibility="Collapsed" Margin="0,0,10,0" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="3" Text="{Binding Track.Duration}" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          <Button x:Name="ResultOpenButton" Grid.Column="4" Content="→" Click="CatalogOpen_Click" Style="{StaticResource PlayerButton}" ToolTip="Открыть"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="track"><Setter TargetName="ResultSurface" Property="MinHeight" Value="46"/><Setter TargetName="CatalogSubtitle" Property="Visibility" Value="Collapsed"/><Setter TargetName="CatalogArtists" Property="Visibility" Value="Visible"/><Setter TargetName="CatalogTrackMarks" Property="Visibility" Value="Visible"/><Setter TargetName="CatalogCoverLink" Property="Visibility" Value="Collapsed"/><Setter TargetName="CatalogTrackCover" Property="Visibility" Value="Visible"/><Setter TargetName="ResultOpenButton" Property="Content" Value="▶"/><Setter TargetName="ResultOpenButton" Property="ToolTip" Value="Слушать трек"/></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="MusicCard">
      <Button Tag="{Binding}" Click="ArtistCard_Click" Padding="8" Margin="0,0,10,10" Background="{DynamicResource PanelBrush}" HorizontalContentAlignment="Stretch" Width="148" ToolTip="{Binding Title}">
        <StackPanel><Border Width="130" Height="130" CornerRadius="12" Background="{DynamicResource CoverPlaceholderBrush}"><Grid><TextBlock Text="♪" FontSize="34" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Width="130" Height="130" Stretch="UniformToFill" local:Artwork.SourceUri="{Binding CoverUri}" local:Artwork.PixelSize="256"><Image.Clip><RectangleGeometry Rect="0,0,130,130" RadiusX="12" RadiusY="12"/></Image.Clip></Image></Grid></Border>
          <TextBlock Text="{Binding Title}" MinHeight="16" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,10,0,0"/>
          <TextBlock Text="{Binding DisplaySubtitle}" MinHeight="16" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,4,0,4"/>
        </StackPanel>
      </Button>
    </DataTemplate>
  </Window.Resources>
  <Grid x:Name="LayoutRoot">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="118"/><RowDefinition Height="24"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="Sidebar" Grid.RowSpan="2" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="16,24,12,12">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="10,0,0,0">
          <StackPanel Orientation="Horizontal"><Image Source="Assets/Yamuse.png" Width="36" Height="36" Margin="0,0,11,0" AutomationProperties.Name="Логотип Yamuse"/><TextBlock Text="Yamuse" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
          <TextBlock Text="Нативный плеер для Windows" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>
        </StackPanel>
        <ScrollViewer x:Name="NavigationScroll" Grid.Row="1" Margin="0,24,0,12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
          <Button x:Name="HomeNav" AutomationProperties.Name="Главная" Style="{StaticResource NavButton}" Click="Home_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource NavIcon}"/><TextBlock Text="Главная" VerticalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="WaveNav" AutomationProperties.Name="Моя волна" Style="{StaticResource NavButton}" Click="Wave_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8D6;" Style="{StaticResource NavIcon}"/><TextBlock Text="Моя волна" VerticalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="SearchNav" AutomationProperties.Name="Поиск" Style="{StaticResource NavButton}" Click="SearchNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" Style="{StaticResource NavIcon}"/><TextBlock Text="Поиск" VerticalAlignment="Center"/></StackPanel></Button>
          <TextBlock Text="МОЯ КОЛЛЕКЦИЯ" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="12,21,0,8"/>
          <Button x:Name="FavoritesNav" AutomationProperties.Name="Мне нравится" Style="{StaticResource NavButton}" Click="Favorites_Click" Background="{DynamicResource AccentSoftBrush}" Foreground="{DynamicResource AccentTextBrush}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xEB51;" Style="{StaticResource NavIcon}"/><TextBlock Text="Мне нравится" VerticalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="CollectionWaveNav" AutomationProperties.Name="Волна по моей коллекции" Style="{StaticResource NavButton}" Click="CollectionWave_Click" ToolTip="Волна по моей коллекции"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8D6;" Style="{StaticResource NavIcon}"/><TextBlock Text="Волна по коллекции" FontSize="12" VerticalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="PlaylistsNav" AutomationProperties.Name="Плейлисты" Style="{StaticResource NavButton}" Click="PlaylistsNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" Style="{StaticResource NavIcon}"/><TextBlock Text="Плейлисты" VerticalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="AlbumsNav" AutomationProperties.Name="Альбомы" Style="{StaticResource NavButton}" Click="AlbumsNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE93C;" Style="{StaticResource NavIcon}"/><TextBlock Text="Альбомы" VerticalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="ArtistsNav" AutomationProperties.Name="Исполнители" Style="{StaticResource NavButton}" Click="ArtistsNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE77B;" Style="{StaticResource NavIcon}"/><TextBlock Text="Исполнители" VerticalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="OfflineNav" AutomationProperties.Name="Скачанное" Style="{StaticResource NavButton}" Click="Offline_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource NavIcon}"/><TextBlock Text="Скачанное" VerticalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="OfflinePlaylistsNav" AutomationProperties.Name="Офлайн-плейлисты" Style="{StaticResource NavButton}" Click="OfflinePlaylists_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource NavIcon}"/><TextBlock Text="Офлайн-плейлисты" VerticalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="DownloadCenterNav" AutomationProperties.Name="Загрузки" Style="{StaticResource NavButton}" Click="DownloadCenter_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource NavIcon}"/><TextBlock Text="Загрузки" VerticalAlignment="Center"/></StackPanel></Button>
          <TextBlock Text="ПРОСЛУШИВАНИЕ" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="12,21,0,8"/>
          <Button x:Name="QueueNav" AutomationProperties.Name="Очередь" Style="{StaticResource NavButton}" Click="Queue_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8FD;" Style="{StaticResource NavIcon}"/><TextBlock Text="Очередь" VerticalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="QueueHistoryNav" AutomationProperties.Name="История" Style="{StaticResource NavButton}" Click="History_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" Style="{StaticResource NavIcon}"/><TextBlock Text="История" VerticalAlignment="Center"/></StackPanel></Button>
        </StackPanel></ScrollViewer>
        <StackPanel Grid.Row="2">
          <Border x:Name="ProfileCard" Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="10,9" Margin="0,0,0,10">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
              <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource CoverPlaceholderBrush}" VerticalAlignment="Top" Margin="0,3,0,0" HorizontalAlignment="Left"><Grid>
                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image x:Name="ProfileAvatar" Width="32" Height="32" Stretch="UniformToFill" local:Artwork.SourceUri="{Binding DataContext.AvatarUri, ElementName=AccountText}" local:Artwork.PixelSize="64"><Image.Clip><EllipseGeometry Center="16,16" RadiusX="16" RadiusY="16"/></Image.Clip></Image>
              </Grid></Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="AccountText" Text="Вход не выполнен" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><TextBlock x:Name="ModeLabel" Text="Яндекс Музыка" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                <Button x:Name="LoginButton" Content="Войти" Click="Login_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Padding="10,5" FontSize="12" Foreground="{DynamicResource AccentTextBrush}"/>
              </StackPanel>
              <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <Button x:Name="RefreshButton" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource QuietButton}" Click="Refresh_Click" Visibility="Collapsed" Width="22" Height="21" Padding="0" FontSize="12" ToolTip="Обновить раздел" AutomationProperties.Name="Обновить раздел"/>
                <Button x:Name="LogoutButton" Content="&#xE8AC;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource QuietButton}" Click="Logout_Click" Visibility="Collapsed" Width="22" Height="21" Padding="0" FontSize="12" ToolTip="Выйти из аккаунта" AutomationProperties.Name="Выйти из аккаунта"/>
              </StackPanel>
            </Grid>
          </Border>
          <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button Content="Мини-плеер" Click="MiniPlayer_Click" Style="{StaticResource QuietButton}" Padding="5,8" FontSize="12"/>
            <Button x:Name="SettingsButton" Grid.Column="1" Content="Настройки" Click="Settings_Click" Style="{StaticResource QuietButton}" Padding="5,8" FontSize="12"/>
          </Grid></Border>
        </StackPanel>
      </Grid>
    </Border>
    <Grid x:Name="ContentGrid" Grid.Column="1" Margin="28,24,28,14">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel><Button x:Name="BrowseBackButton" DockPanel.Dock="Left" Content="← Назад" Click="BrowseBack_Click" Style="{StaticResource QuietButton}" Visibility="Collapsed" Padding="12,6" MinHeight="32" HorizontalAlignment="Left"/></DockPanel>
      <StackPanel Grid.Row="1" Margin="0,0,0,12">
        <ContentControl x:Name="CollectionHero" Visibility="Collapsed" HorizontalContentAlignment="Stretch" Margin="0,0,0,12"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="CollectionTitle" Text="Мне нравится" FontSize="32" FontWeight="Bold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          <StackPanel x:Name="ListSortControls" Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
            <ComboBox x:Name="ListSortCombo" Width="186" Height="32" FontSize="12" DisplayMemberPath="Label" SelectedValuePath="Field" SelectionChanged="ListSort_Changed" AutomationProperties.Name="Сортировка списка"/>
            <Button x:Name="SortDirectionButton" Content="↑" Width="32" Height="32" Padding="0" Margin="6,0,0,0" Click="SortDirection_Click" AutomationProperties.Name="Направление сортировки"/>
          </StackPanel>
        </Grid>
        <WrapPanel x:Name="CollectionSummary" Margin="1,6,0,0"><TextBlock x:Name="CountText" Text="Любимые треки из вашего аккаунта" Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock x:Name="PlaylistDownloadText" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="16,1,0,0"/></WrapPanel>
        <WrapPanel x:Name="CollectionToolbar" Margin="0,12,0,0">
          <Button x:Name="PlaySelectionButton" Content="▶  Слушать" IsEnabled="False" Click="PlaySelection_Click" Style="{StaticResource AccentButton}" Padding="15,8" Margin="0,0,8,4"/>
          <WrapPanel x:Name="PlaylistActions" Visibility="Collapsed">
            <Button x:Name="FavoritesWaveButton" Content="≈ Волна" Click="CollectionWave_Click" Padding="11,8" FontSize="12" Margin="0,0,8,4" Visibility="Collapsed" ToolTip="Волна по вашей коллекции"/>
            <Button x:Name="DownloadPlaylistButton" Content="↓ Скачать плейлист" ContentTemplate="{StaticResource DownloadActionContent}" Click="DownloadPlaylist_Click" Padding="11,8" FontSize="12" Margin="0,0,8,4" Visibility="Collapsed"/>
            <CheckBox x:Name="AutoFavoritesCheckBox" Content="Автоскачивание" FontSize="12" Checked="AutoFavorites_Changed" Unchecked="AutoFavorites_Changed" VerticalAlignment="Center" Margin="4,0,12,4" Visibility="Collapsed" ToolTip="Автоматически сохранять все треки и новые добавления в «Мне нравится»"/>
            <Button x:Name="MoreArtistButton" Content="Ещё треки" Click="MoreArtist_Click" Padding="11,8" FontSize="12" Margin="0,0,8,4" Visibility="Collapsed"/>
            <Button x:Name="CreatePlaylistButton" Content="＋ Плейлист" Click="CreatePlaylist_Click" Padding="11,8" FontSize="12" Margin="0,0,8,4" Visibility="Collapsed"/>
          </WrapPanel>
          <Button x:Name="DownloadButton" Content="↓" Foreground="{StaticResource DownloadBrush}" Click="Download_Click" IsEnabled="False" Padding="0" Width="34" Height="34" Margin="0,0,6,4" ToolTip="Скачать выбранные треки · сначала выделите строки в списке" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Скачать выделенные треки"/>
          <Button x:Name="CollectionOptionsButton" Content="⋯" Click="CollectionOptions_Click" Width="34" Height="34" Padding="0" FontSize="19" Margin="0,0,0,4" ToolTip="Качество и действия" AutomationProperties.Name="Качество и действия"/>
        </WrapPanel>
        <Popup x:Name="CollectionOptionsPopup" PlacementTarget="{Binding ElementName=CollectionOptionsButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Focusable="False">
          <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Width="245" Margin="0,5,0,0">
            <StackPanel><TextBlock Text="Качество звука" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
              <ComboBox x:Name="QualityCombo" SelectedIndex="0" SelectionChanged="Quality_Changed" AutomationProperties.Name="Качество аудио"><ComboBoxItem Content="Превосходное" ToolTip="Lossless и другие высококачественные форматы"/><ComboBoxItem Content="Оптимальное" ToolTip="Сбалансированный звук"/><ComboBoxItem Content="Экономичное" ToolTip="Меньший расход трафика"/></ComboBox>
              <Button Content="Открыть папку скачанного" Click="OpenMusicFolder_Click" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Padding="10,8" Margin="0,4,0,0" FontSize="12"/>
              <Button x:Name="RenamePlaylistButton" Content="Переименовать плейлист" Click="RenamePlaylist_Click" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Padding="10,8" FontSize="12" Visibility="Collapsed"/>
              <Button x:Name="RemovePlaylistTrackButton" Content="Убрать выбранный трек" Click="RemovePlaylistTrack_Click" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Padding="10,8" FontSize="12" Visibility="Collapsed"/>
              <Button x:Name="DeletePlaylistButton" Content="Удалить плейлист" Click="DeletePlaylist_Click" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Padding="10,8" Foreground="{DynamicResource AccentTextBrush}" FontSize="12" Visibility="Collapsed"/>
            </StackPanel>
          </Border>
        </Popup>
      </StackPanel>
      <StackPanel Grid.Row="2">
        <Border x:Name="PlaylistTransferPanel" Visibility="Collapsed" MinHeight="36" Padding="0,4" Margin="0,0,0,8">
          <Grid>
