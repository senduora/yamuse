          <Button x:Name="PreviousButton" Content="&#xE892;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource PlayerButton}" AutomationProperties.Name="Предыдущий трек" ToolTip="Предыдущий трек" Click="Previous_Click" IsEnabled="False"/>
          <Button x:Name="PlayPauseButton" Content="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="17" Style="{StaticResource RoundPlayButton}" AutomationProperties.Name="Воспроизведение или пауза" ToolTip="Воспроизведение / пауза · Пробел" Margin="10,0" Click="PlayPause_Click" IsEnabled="False"/>
          <Button x:Name="NextButton" Content="&#xE893;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource PlayerButton}" AutomationProperties.Name="Следующий трек" ToolTip="Следующий трек" Click="Next_Click" IsEnabled="False"/>
          <Button x:Name="RepeatButton" Style="{StaticResource PlayerButton}" Click="Repeat_Click" AutomationProperties.Name="Повтор" ToolTip="Повтор"><Grid Width="24" Height="28">
            <Path x:Name="RepeatArrows" Data="M 4,14 V 10 Q 4,6 8,6 H 20 M 17,3 L 20,6 L 17,9 M 20,14 V 18 Q 20,22 16,22 H 4 M 7,19 L 4,22 L 7,25" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            <Path x:Name="RepeatOneLabel" Data="M 10,12 L 12,10 V 18 M 10,18 H 14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
            <Ellipse x:Name="RepeatIndicator" Width="3" Height="3" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Bottom" Visibility="Collapsed"/>
          </Grid></Button>
        </StackPanel>
        <Grid x:Name="AudioControls" Grid.Column="2" VerticalAlignment="Center" Margin="18,0,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
            <Button x:Name="PlaybackContextButton" Width="30" Height="34" Click="PlaybackContext_Click" Visibility="Collapsed" IsEnabled="False" ToolTip="Источник очереди неизвестен" AutomationProperties.Name="Источник очереди неизвестен">
              <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PlayerButton}"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/></Trigger></Style.Triggers></Style></Button.Style>
              <Path Data="M 3,4 H 15 M 3,8 H 12 M 3,12 H 9 M 15,11 V 19 M 11,15 L 15,11 L 19,15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="17" Height="17"/>
            </Button>
            <Button x:Name="PlayerQueueButton" Style="{StaticResource PlayerButton}" Width="30" Click="PlayerQueue_Click" ToolTip="Очередь воспроизведения" AutomationProperties.Name="Очередь воспроизведения">
              <Path Data="M 3,4 H 14 M 3,8 H 14 M 3,12 H 9 M 12,12 L 12,20 L 19,16 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="17" Height="17"/>
            </Button>
            <Button x:Name="PlayerLyricsButton" Content="Тт" FontSize="13" Style="{StaticResource PlayerButton}" Width="28" Click="Lyrics_Click" ToolTip="Текст песни" AutomationProperties.Name="Открыть текст песни" IsEnabled="False"/>
            <Button x:Name="ExpandPlayerButton" Content="&#xE740;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource PlayerButton}" Width="30" Click="ExpandPlayer_Click" ToolTip="Развернуть проигрыватель" AutomationProperties.Name="Развернуть проигрыватель" IsEnabled="False"/>
          </StackPanel>
          <Grid x:Name="AudioVolumePanel" Grid.Column="1" Margin="6,0,0,0">
            <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid x:Name="AudioVolumeRow" Width="{Binding ActualWidth, ElementName=AudioVolumePanel}" MaxWidth="168" HorizontalAlignment="Right">
              <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="14"/>
              <Slider Grid.Column="1" x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="50" ValueChanged="Volume_Changed" AutomationProperties.Name="Громкость" ToolTip="{Binding Value, RelativeSource={RelativeSource Self}, StringFormat={}{0:F0}%}"/>
            </Grid>
            <TextBlock Grid.Row="1" x:Name="QualityText" Text="" Foreground="{StaticResource MutedBrush}" FontSize="12" TextAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
          </Grid>
        </Grid>
        <Grid x:Name="TimelinePanel" Grid.Row="1" Grid.ColumnSpan="3" VerticalAlignment="Center" Margin="0,3,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="PositionText" Text="0:00" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
          <Grid Grid.Column="1" x:Name="TimelineSeekHost">
            <Slider x:Name="SeekSlider" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" IsEnabled="False" PreviewKeyUp="Seek_KeyUp" AutomationProperties.Name="Позиция воспроизведения"/>
            <Grid x:Name="SeekHoverOverlay" IsHitTestVisible="False" Visibility="Collapsed">
              <Border x:Name="SeekHoverRange" HorizontalAlignment="Left" Margin="8,0,0,0" Height="4" CornerRadius="2" Background="#70B9B8C1"/>
              <Canvas><Border x:Name="SeekHoverMarker" Width="2" Height="14" Background="{DynamicResource ForegroundBrush}" CornerRadius="1" Canvas.Top="6"/><Border x:Name="SeekHoverBubble" Width="60" Height="25" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource StrongBorderBrush}" BorderThickness="1" CornerRadius="7" Canvas.Top="-22"><TextBlock x:Name="SeekHoverTime" Foreground="{DynamicResource ForegroundBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Canvas>
            </Grid>
          </Grid>
          <TextBlock Grid.Column="2" x:Name="DurationText" Text="0:00" Foreground="{StaticResource MutedBrush}" FontSize="12" TextAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
      </Grid>
    </Border>
    <Border x:Name="MetricsBar" Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="22,0">
      <Grid x:Name="FooterContent">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel x:Name="MetricsRow" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Ресурсы процесса Yamuse">
          <TextBlock x:Name="VersionText" Text="{x:Static local:AppBranding.VersionLabel}" Foreground="{DynamicResource AccentTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
          <Button x:Name="FooterUpdateButton" Content="↻" Width="22" Height="20" Padding="0" Margin="0,0,14,0" FontSize="13" Click="FooterUpdate_Click" Style="{StaticResource QuietButton}" ToolTip="Проверить обновления" AutomationProperties.Name="Проверить обновления"/>
          <TextBlock x:Name="MemoryText" Text="RAM всего — МБ" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,18,0" ToolTip="Общий рабочий набор: собственная и общая физическая память процесса. В диспетчере задач столбец «Память» обычно показывает только частный рабочий набор."/>
          <TextBlock x:Name="CpuText" Text="CPU —" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,18,0" ToolTip="CPU процесса в процентах всей мощности ПК"/>
          <Button x:Name="GithubButton" Content="GitHub" Height="20" Padding="5,0" Margin="0,0,6,0" FontSize="11" Click="Github_Click" Style="{StaticResource QuietButton}" ToolTip="Проект Yamuse на GitHub" AutomationProperties.Name="Проект Yamuse на GitHub"/>
          <Button x:Name="ChangelogButton" Content="Changelog" Height="20" Padding="5,0" FontSize="11" Click="Changelog_Click" Style="{StaticResource QuietButton}" ToolTip="История выпусков Yamuse" AutomationProperties.Name="История выпусков Yamuse"/>
        </StackPanel>
        <Border x:Name="StatusNotification" Grid.Column="1" Panel.ZIndex="300" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="18,0,0,7" MaxWidth="620" Visibility="Collapsed" Opacity="0" AutomationProperties.Name="Уведомление">
          <Border.RenderTransform><TranslateTransform x:Name="StatusNotificationOffset" Y="14"/></Border.RenderTransform>
          <TextBlock x:Name="StatusText" Foreground="{DynamicResource AccentTextBrush}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite"/>
        </Border>
      </Grid>
    </Border>
    <ContentControl x:Name="ExpandedPlayerHost" Grid.ColumnSpan="2" Grid.RowSpan="3" Panel.ZIndex="200" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  </Grid>
</Window>
