        </Grid>
      </StackPanel>
      <Grid Grid.Row="3">
        <ListView x:Name="TracksList" local:SmoothScroll.Enabled="True" SelectionMode="Extended" Background="Transparent" Foreground="{DynamicResource ForegroundBrush}" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" MouseDoubleClick="Tracks_DoubleClick" SelectionChanged="Tracks_SelectionChanged" PreviewMouseRightButtonDown="Track_RightClick">
          <ListView.ContextMenu><ContextMenu>
            <MenuItem Header="Добавить в избранное" Click="LikeTrack_Click"><MenuItem.Icon><Path Data="{StaticResource MenuLikeGeometry}" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon></MenuItem>
            <MenuItem Header="Убрать из избранного" Click="UnlikeTrack_Click"><MenuItem.Icon><Path Data="{StaticResource MenuUnlikeGeometry}" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon></MenuItem>
            <Separator/>
            <MenuItem Header="Играть следующим" Click="PlayNext_Click"><MenuItem.Icon><Path Data="{StaticResource MenuNextGeometry}" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon></MenuItem>
            <MenuItem Header="Добавить в очередь" Click="Enqueue_Click"><MenuItem.Icon><Path Data="{StaticResource MenuQueueGeometry}" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon></MenuItem>
            <Separator/>
            <MenuItem Header="Добавить в плейлист…" Click="AddToPlaylist_Click"><MenuItem.Icon><Path Data="{StaticResource MenuPlaylistGeometry}" Style="{StaticResource MenuGlyph}"/></MenuItem.Icon></MenuItem>
