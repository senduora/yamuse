                    <TextBlock Text="{Binding Title}" MinHeight="19" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding DisplaySubtitle}" MinHeight="18" FontSize="12" LineHeight="18" MaxHeight="36" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
