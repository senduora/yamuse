<Application x:Class="YMusic.Native.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:local="clr-namespace:YMusic.Native">
  <Application.Resources>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#101114" />
    <SolidColorBrush x:Key="PanelBrush" Color="#17191D" />
    <SolidColorBrush x:Key="MutedBrush" Color="#ADB0BA" />
    <SolidColorBrush x:Key="AccentBrush" Color="#EA571C" />
    <SolidColorBrush x:Key="TrackBrush" Color="#34363D" />
    <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="{StaticResource BackgroundBrush}"/><Setter Property="Foreground" Value="#F3F1F0"/><Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/><Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/><Setter Property="UseLayoutRounding" Value="True"/></Style>
    <Style TargetType="Image"><Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/></Style>
    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="#292C33"/><Setter Property="Foreground" Value="#F3F1F0"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/><Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/><Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/><Setter Property="Padding" Value="12,8"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip"><Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsCard" TargetType="Border"><Setter Property="Background" Value="{StaticResource PanelBrush}"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
    <Style x:Key="SettingsHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,18"/></Style>
    <Style x:Key="SettingsNote" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="FontSize" Value="13"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="20"/></Style>
    <Style TargetType="ScrollViewer"><Setter Property="local:SmoothScroll.Enabled" Value="True"/></Style>
    <Style x:Key="KeyboardButtonFocus" TargetType="Control">
      <Setter Property="Template"><Setter.Value><ControlTemplate><Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="7" Margin="2" IsHitTestVisible="False" SnapsToDevicePixels="True"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="KeyboardLinkFocus" TargetType="Control">
      <Setter Property="Template"><Setter.Value><ControlTemplate><Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="4" Margin="1" IsHitTestVisible="False" SnapsToDevicePixels="True"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#25282F"/><Setter Property="Foreground" Value="#E9E7E7"/><Setter Property="Padding" Value="14,8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid x:Name="ButtonSurface">
          <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
            <ContentPresenter x:Name="ButtonContent" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
          <Border x:Name="ButtonHover" Background="White" CornerRadius="8" Margin="1" local:Motion.Opacity="0" IsHitTestVisible="False"/>
          <Border x:Name="ButtonKeyboardFocus" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="7" Margin="2" Opacity="0" IsHitTestVisible="False"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonHover" Property="local:Motion.Opacity" Value="0.065"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonHover" Property="local:Motion.Opacity" Value="0.12"/><Setter TargetName="ButtonSurface" Property="local:Motion.Opacity" Value="0.85"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonKeyboardFocus" Property="Opacity" Value="1"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="local:Motion.Opacity" Value="0.35"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="TextLink" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="4,3"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid x:Name="LinkSurface">
          <Border x:Name="LinkChrome" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter x:Name="LinkContent" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="False"/>
          </Border>
          <Border x:Name="LinkKeyboardFocus" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="4" Margin="1" Opacity="0" IsHitTestVisible="False"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#F37843"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="LinkSurface" Property="local:Motion.Opacity" Value="0.65"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter TargetName="LinkKeyboardFocus" Property="Opacity" Value="1"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="LinkSurface" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="FlatListItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardButtonFocus}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="8"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#202227"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#2B2D34"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="#211613"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/></Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="Foreground" Value="#B8BAC3"/><Setter Property="FontSize" Value="13"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Height" Value="35"/><Setter Property="Padding" Value="12,0"/><Setter Property="Margin" Value="0,1"/></Style>
    <Style x:Key="NavIcon" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="16"/><Setter Property="Width" Value="28"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style x:Key="PlayerButton" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="0"/></Style>
    <Style x:Key="RoundPlayButton" TargetType="Button" BasedOn="{StaticResource AccentButton}"><Setter Property="Width" Value="44"/><Setter Property="Height" Value="44"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid x:Name="PlaySurface" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><ScaleTransform x:Name="PlayScale"/></Grid.RenderTransform><Ellipse x:Name="Disc" local:Motion.Fill="{TemplateBinding Background}"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse x:Name="FocusRing" Stroke="{StaticResource AccentBrush}" StrokeThickness="1" Margin="-4" local:Motion.Opacity="0" IsHitTestVisible="False"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Disc" Property="local:Motion.Fill" Value="#F37843"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Disc" Property="local:Motion.Opacity" Value="0.7"/><Setter TargetName="PlaySurface" Property="local:Motion.Scale" Value="0.95"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="local:Motion.Opacity" Value="1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#1A1C21"/><Setter Property="Foreground" Value="#F3F1F0"/><Setter Property="BorderBrush" Value="#303239"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="13,10"/><Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/><Setter Property="SelectionBrush" Value="#664238"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="InputBorder" Background="{TemplateBinding Background}" local:Motion.BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InputBorder" Property="local:Motion.BorderBrush" Value="#555861"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="local:Motion.BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="InputBorder" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- Native Track behavior, generous hit area, no third-party controls. -->
    <Style x:Key="SliderSegment" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}" Height="4" CornerRadius="2" VerticalAlignment="Center"/></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="SliderHandle" TargetType="Thumb"><Setter Property="Width" Value="16"/><Setter Property="Height" Value="26"/><Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Ellipse x:Name="Handle" Width="10" Height="10" local:Motion.Fill="{StaticResource AccentBrush}" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform x:Name="HandleScale"/></Ellipse.RenderTransform></Ellipse></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Handle" Property="local:Motion.Scale" Value="1.4"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Handle" Property="local:Motion.Scale" Value="1.4"/><Setter TargetName="Handle" Property="local:Motion.Fill" Value="#FFA498"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Slider"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Height" Value="26"/><Setter Property="IsMoveToPointEnabled" Value="True"/><Setter Property="SmallChange" Value="1"/><Setter Property="LargeChange" Value="10"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid x:Name="SliderSurface" Background="Transparent"><Border x:Name="Rail" Height="4" Margin="8,0" CornerRadius="2" local:Motion.Background="{StaticResource TrackBrush}"/><Track x:Name="PART_Track" IsDirectionReversed="{TemplateBinding IsDirectionReversed}" Orientation="{TemplateBinding Orientation}"><Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SliderSegment}" Background="{StaticResource AccentBrush}" Command="{x:Static Slider.DecreaseLarge}" Margin="8,0,0,0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource SliderHandle}"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SliderSegment}" Background="Transparent" Command="{x:Static Slider.IncreaseLarge}" Margin="0,0,8,0"/></Track.IncreaseRepeatButton></Track><Border x:Name="SliderFocus" CornerRadius="6" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" local:Motion.Opacity="0" IsHitTestVisible="False"/></Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SliderFocus" Property="local:Motion.Opacity" Value="0.65"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Rail" Property="local:Motion.Background" Value="#45474F"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="SliderSurface" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ScrollPage" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="ScrollHandle" TargetType="Thumb"><Setter Property="MinHeight" Value="28"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="Transparent"><Border x:Name="Handle" Width="4" local:Motion.Background="#51545D" CornerRadius="2" Margin="0,2" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform x:Name="ScrollScale"/></Border.RenderTransform></Border></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Handle" Property="local:Motion.Background" Value="#8E929D"/><Setter TargetName="Handle" Property="local:Motion.ScaleX" Value="1.5"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Handle" Property="local:Motion.Background" Value="{StaticResource AccentBrush}"/><Setter TargetName="Handle" Property="local:Motion.ScaleX" Value="1.5"/></Trigger><DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="Horizontal"><Setter TargetName="Handle" Property="local:Motion.ScaleX" Value="1"/><Setter TargetName="Handle" Property="Width" Value="Auto"/><Setter TargetName="Handle" Property="Height" Value="4"/><Setter TargetName="Handle" Property="Margin" Value="2,0"/></DataTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Style.Resources><sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">56</sys:Double><sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}">56</sys:Double></Style.Resources>
      <Setter Property="Width" Value="10"/><Setter Property="Background" Value="Transparent"/><Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True" ViewportSize="{TemplateBinding ViewportSize}"><Track.DecreaseRepeatButton><RepeatButton x:Name="PageBefore" Style="{StaticResource ScrollPage}" Command="{x:Static ScrollBar.PageUpCommand}"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb x:Name="ScrollThumb" Style="{StaticResource ScrollHandle}"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton x:Name="PageAfter" Style="{StaticResource ScrollPage}" Command="{x:Static ScrollBar.PageDownCommand}"/></Track.IncreaseRepeatButton></Track></Grid><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="PageBefore" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/><Setter TargetName="PageAfter" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/><Setter TargetName="ScrollThumb" Property="MinHeight" Value="0"/><Setter TargetName="ScrollThumb" Property="MinWidth" Value="28"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="10"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="CheckFrame" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#1A1C21" BorderBrush="#646976" BorderThickness="1" CornerRadius="4"><Path x:Name="CheckMark" Data="M 3,7 L 6,10 L 11,4" Stroke="#211613" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/></Border><ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckFrame" Property="Background" Value="{StaticResource AccentBrush}"/><Setter TargetName="CheckFrame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckFrame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="CheckFrame" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#F3F1F0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,1"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Grid x:Name="ItemSurface">
        <Border x:Name="Item" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="7"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border>
        <Border x:Name="ItemKeyboardFocus" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="5" Margin="2" Opacity="0" IsHitTestVisible="False"/>
      </Grid><ControlTemplate.Triggers>
        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#34373F"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#3D2A21"/><Setter TargetName="Item" Property="BorderBrush" Value="#6D3F2B"/><Setter Property="Foreground" Value="#FFB18F"/></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ItemKeyboardFocus" Property="Opacity" Value="1"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ItemSurface" Property="Opacity" Value="0.4"/></Trigger>
      </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#F3F1F0"/><Setter Property="Background" Value="#25272D"/><Setter Property="Padding" Value="12,7"/><Setter Property="BorderBrush" Value="#393E47"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="MinHeight" Value="32"/><Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid x:Name="ComboSurface">
        <Border x:Name="ComboChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"/>
        <ToggleButton x:Name="DropDownToggle" Focusable="False" IsTabStop="False" FocusVisualStyle="{x:Null}" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}" BorderThickness="{TemplateBinding BorderThickness}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="Transparent" Padding="{TemplateBinding Padding}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions><ContentPresenter Margin="0,0,8,0" TextElement.Foreground="{TemplateBinding Foreground}" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="⌄" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#ADB0BA"/></Grid></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
        <Border x:Name="ComboKeyboardFocus" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="7" Margin="2" Opacity="0" IsHitTestVisible="False"/>
        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#25272D" BorderBrush="#393E47" BorderThickness="1" CornerRadius="10" Padding="4" Margin="0,5,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
      </Grid><ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboChrome" Property="Background" Value="#2C3038"/><Setter TargetName="ComboChrome" Property="BorderBrush" Value="#555861"/></Trigger>
        <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="ComboChrome" Property="BorderBrush" Value="#F37843"/></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboKeyboardFocus" Property="Opacity" Value="1"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboSurface" Property="Opacity" Value="0.4"/></Trigger>
      </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ContextMenu"><Setter Property="Background" Value="#25272D"/><Setter Property="Foreground" Value="#F3F1F0"/></Style>
  </Application.Resources>
</Application>
