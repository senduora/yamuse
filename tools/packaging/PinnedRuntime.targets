<Project>
  <PropertyGroup>
    <!-- The SDK is pinned by global.json. Its runtime patch is verified after
         publish; a global RuntimeFrameworkVersion corrupts Windows profile packs. -->
    <TargetLatestRuntimePatch>true</TargetLatestRuntimePatch>
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
  </PropertyGroup>
</Project>
